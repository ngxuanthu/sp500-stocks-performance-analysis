            <column-instance column='[Calculation_6259088998682628]' derivation='User' name='[usr:Calculation_6259088998682628:qk:15]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='Year' name='[yr:date:ok]' pivot='key' type='ordinal' />
