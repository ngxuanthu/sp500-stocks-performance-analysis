              <calculation class='tableau' formula='(&#10;    { FIXED [symbol], YEAR([date]) :&#10;        MAX(&#10;            IF [date] = { FIXED [symbol], YEAR([date]) : MAX([date]) }&#10;            THEN [close]&#10;            END&#10;        )&#10;    }&#10;    /&#10;    { FIXED [symbol], YEAR([date]) :&#10;        MAX(&#10;            IF [date] = { FIXED [symbol], YEAR([date]) : MIN([date]) }&#10;            THEN [close]&#10;            END&#10;        )&#10;    }&#10;) - 1' />
            </column>
            <column caption='Annualized Volatility' datatype='real' default-format='p0.0%' name='[Calculation_6259088998682628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV([daily return]) * SQRT(252)' />
