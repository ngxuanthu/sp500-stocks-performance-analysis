    <worksheet name='KPI - Avg Annualized Volatility'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='2' fontname='Tableau Medium' fontsize='9'>Avg Annualized Volatility</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sp500_stocks+' name='federated.1wsyslj0artd4d18tbu5h04ap9k3' />
          </datasources>
          <datasource-dependencies datasource='federated.1wsyslj0artd4d18tbu5h04ap9k3'>
            <column caption='Annualized Volatility' datatype='real' default-format='p0.0%' name='[Calculation_6259088998682628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV([daily return]) * SQRT(252)' />
