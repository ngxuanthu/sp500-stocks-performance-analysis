      <aliases enabled='yes' />
      <column caption='Annual Return' datatype='real' default-format='p0.0%' name='[Calculation_6259088978403328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    { FIXED [symbol], YEAR([date]) :&#10;        MAX(&#10;            IF [date] = { FIXED [symbol], YEAR([date]) : MAX([date]) }&#10;            THEN [close]&#10;            END&#10;        )&#10;    }&#10;    /&#10;    { FIXED [symbol], YEAR([date]) :&#10;        MAX(&#10;            IF [date] = { FIXED [symbol], YEAR([date]) : MIN([date]) }&#10;            THEN [close]&#10;            END&#10;        )&#10;    }&#10;) - 1' />
      </column>
      <column caption='Annualized Volatility' datatype='real' default-format='p0.0%' name='[Calculation_6259088998682628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([daily return]) * SQRT(252)' />
      </column>
      <column caption='Is Last Trading Day' datatype='boolean' name='[Calculation_6259089004158986]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] =&#10;{ FIXED [symbol], YEAR([date]) : MAX([date]) }' />
      </column>
      <column caption='Top N Filter' datatype='boolean' name='[Calculation_6259089067687958]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(AVG([Calculation_6259088978403328]), &apos;desc&apos;) &lt;= [Parameters].[Paramètre 6259089066754069]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Max Annual Return' datatype='real' name='[Calculation_6259091177553945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED YEAR([date]) :&#10;    MAX(&#10;        { FIXED [symbol], YEAR([date]) :&#10;            MAX([Calculation_6259088978403328])&#10;        }&#10;    )&#10;}' />
      </column>
      <column caption='Avg Return by Company' datatype='real' name='[Calculation_6259091313991707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [symbol] : AVG([Calculation_6259088978403328]) }' />
      </column>
      <column caption='Positive Return %' datatype='real' default-format='p0.0%' name='[Calculation_6259091314188316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_6259091313991707] &gt; 0&#10;    THEN [symbol]&#10;    END&#10;)&#10;/&#10;COUNTD([symbol])' />
      </column>
      <column caption='sp500_companies.csv' datatype='table' name='[__tableau_internal_object_id__].[sp500_companies.csv_39AFA199294C4F288D2EB629C24B9571]' role='measure' type='quantitative' />
